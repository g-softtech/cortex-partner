# ==========================================
# DATABASE (Neon PostgreSQL)
# ==========================================
# Use the POOLED connection string for the app (pgBouncer)
DATABASE_URL="postgres://user:password@hostname/db?pgbouncer=true&sslmode=require"

# Use the DIRECT (non-pooled) connection for Prisma migrations
DIRECT_URL="postgres://user:password@hostname/db?sslmode=require"

# ==========================================
# AUTHENTICATION (NextAuth.js)
# ==========================================
# Generate a strong secret: openssl rand -hex 32
NEXTAUTH_SECRET="generate-with-openssl-rand-hex-32"

# Your production domain (no trailing slash). Used for callbacks + redirect URLs.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app  OR  https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Public app URL — used to build links inside emails (setup, password reset).
# Must match NEXTAUTH_URL in most cases.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NEXTAUTH_URL="https://partner.thecortexsystems.com"
NEXT_PUBLIC_APP_URL="https://partner.thecortexsystems.com"
NEXTAUTH_SECRET="<generate_a_random_32_character_string>"

# ==========================================
# EMAIL (Resend)
# ==========================================
# Get your API key from https://resend.com/api-keys
# Ensure your sending domain (thecortexsystems.com) is verified in Resend.
RESEND_API_KEY="re_123456789"

# ==========================================
# FILE STORAGE (Cloudflare R2)
# ==========================================
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="cortex-partner-files"
# Public URL for the R2 bucket (if using a custom domain or R2 public bucket)
R2_PUBLIC_URL="https://files.yourdomain.com"

# ==========================================
# ERROR MONITORING (Sentry)
# ==========================================
NEXT_PUBLIC_SENTRY_DSN="https://..."
SENTRY_ORG="..."
SENTRY_PROJECT="..."
SENTRY_AUTH_TOKEN="..."
