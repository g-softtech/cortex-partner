# Database (Neon)
# Use the pooled connection string for standard queries
DATABASE_URL="postgres://user:password@hostname/db?pgbouncer=true"

# Use the direct connection string for Prisma migrations
DIRECT_URL="postgres://user:password@hostname/db"

# Authentication
NEXTAUTH_SECRET="generate-a-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 Storage
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="cortex-partner-files"

# Email
RESEND_API_KEY="re_..."
